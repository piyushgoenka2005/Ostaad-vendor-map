# Cloudflare D1 Read-Only REST API Configuration
# Find your Account ID in Cloudflare Dashboard -> Workers & Pages -> Overview (right sidebar)
CF_ACCOUNT_ID=

# Production Ostaad D1 Database ID (ostaad-db)
CF_D1_DATABASE_ID=8363bc75-2f49-4b66-95c3-8b5968c9936b

# Read-Only Cloudflare API Token with permission: Account -> D1 -> Read
CF_API_TOKEN=

# Internal Ops Access Gate Password
# Leave blank in local development for direct access (dev-mode badge shown).
# Required in production (Vercel) to protect vendor data behind a signed HttpOnly session cookie.
MAP_ACCESS_PASSWORD=
